# ── Question Miner service ────────────────────────────────────────────
QUESTION_MINER_HOST=0.0.0.0
QUESTION_MINER_PORT=8010

# ── Ollama (local LLM) ────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=120

# ── Question-service (port 8081) ──────────────────────────────────────
# FIX: was 8080 (Auth-service) — must point to Question-service
QUESTION_SERVICE_BASE_URL=http://127.0.0.1:8081
# FIX: was /api/questions/bulk and /api/questions — Spring Boot only exposes /question/add
QUESTION_SERVICE_ADD_PATH=/question/add
QUESTION_SERVICE_TIMEOUT_SECONDS=30

# ── Auth-service credentials for JWT auto-refresh (port 8080) ─────────
# Set these to the admin account's credentials so the miner can obtain
# (and silently renew) its own JWT without manual token rotation.
AUTH_SERVICE_BASE_URL=http://127.0.0.1:8080
AUTH_SERVICE_ADMIN_USERNAME=
AUTH_SERVICE_ADMIN_PASSWORD=

# ── PDF processing ────────────────────────────────────────────────────
PDF_MAX_SIZE_MB=15
PDF_TEXT_CHAR_BUDGET=18000
